---
// Fruiting Currents — Refined Minimal Layout
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Fruiting Currents</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400&family=Playfair+Display:ital@1&family=Plus+Jakarta+Sans:wght@300;400&display=swap" rel="stylesheet">
</head>
<body>

    <div class="bg-mist"></div>

    <div class="site-wrapper">

        <header class="main-header">
            <h1>Fruiting Currents</h1>
        </header>

        <div class="artwork-window"></div>

        <main class="content-flow">

            <section class="node">
                <a href="https://fruitingcurrents.substack.com" class="main-link" target="_blank">The Substack Journal</a>
                <p class="description">Essays on cyclical transitions, somatic ecology, and currents beneath the surface.</p>
            </section>

            <section class="node">
                <a href="#booking" class="main-link">Natal Astrology Readings</a>
                <p class="description">An archival look at your birth chart blueprint to map out personal structural timing.</p>
            </section>

            <section class="node">
                <a href="/divination" class="main-link">Request a Divination</a>
                <p class="description">Symbolic imagery consulting for clarity on projects, internal blocks, and transformation cycles.</p>
            </section>

            <div class="divider"></div>

            <section class="about-node">
                <h2>About Me</h2>
                <p class="about-text">A creative practitioner merging traditional symbolic modalities with clinical frameworks, holding space for structural and cosmic alignment.</p>
            </section>

        </main>

    </div>

</body>
</html>

<style>
    /* Absolute Core Reset */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        background-color: #f6f3f0;
        color: #2a2825;
        font-family: 'Plus Jakarta Sans', sans-serif;
        /* Disables horizontal side-scrolling / shaking on mobile entirely */
        overflow-x: hidden;
        width: 100%;
        -webkit-text-size-adjust: 100%;
    }

    body {
        position: relative;
    }

    /* Soft ambient background mist */
    .bg-mist {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at 80% 15%, rgba(243, 215, 215, 0.45) 0%, rgba(213, 226, 235, 0.4) 45%, rgba(246, 243, 240, 0) 100%);
        z-index: 0;
        pointer-events: none;
    }

    /* Central Containment Frame */
    .site-wrapper {
        position: relative;
        z-index: 1;
        max-width: 460px; /* Snug, editorial column width */
        margin: 0 auto;
        padding: 5rem 1.25rem 8rem 1.25rem; /* Generous 8rem bottom padding for space below About Me */
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Perfectly centered header with mirrored top/bottom margins */
    .main-header {
        width: 100%;
        text-align: center;
        margin-top: 1rem;
        margin-bottom: 3.5rem;
    }

    .main-header h1 {
        font-family: 'Cinzel', serif;
        font-weight: 400;
        font-size: clamp(1.75rem, 6vw, 2.25rem);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #3a3530;
        line-height: 1.2;
    }

    /* The visual center block */
    .artwork-window {
        width: 100%;
        height: 250px;
        background: linear-gradient(135deg, #e3dcd5 0%, #d4cbd6 40%, #cce0df 80%, #ebdcd5 100%);
        border-radius: 2px;
        margin-bottom: 4rem;
        border: 1px solid rgba(0, 0, 0, 0.015);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
    }

    /* Main body text & link architecture */
    .content-flow {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 3rem; /* Perfectly equal rhythm between blocks */
        text-align: center;
    }

    .node {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .main-link {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-size: 1.3rem;
        color: #2a2825;
        text-decoration: none;
        border-bottom: 1px solid rgba(42, 40, 37, 0.8);
        padding-bottom: 3px;
        margin-bottom: 0.65rem;
        transition: opacity 0.3s ease, border-color 0.3s ease;
        display: inline-block;
    }

    .main-link:hover {
        opacity: 0.5;
        border-bottom-color: rgba(42, 40, 37, 0.2);
    }

    .description {
        font-size: 0.88rem;
        line-height: 1.55;
        color: #6a635a;
        font-weight: 300;
        max-width: 360px;
    }

    .divider {
        width: 35px;
        height: 1px;
        background-color: #e2ded9;
        margin: 0.5rem auto;
    }

    /* Integrated About Me Layout */
    .about-node {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .about-node h2 {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #4a453f;
        margin-bottom: 0.85rem;
    }

    .about-text {
        font-size: 0.88rem;
        line-height: 1.65;
        color: #5a534a;
        font-weight: 300;
        max-width: 380px;
    }

    /* Mobile adjustments to handle scaling safely */
    @media (max-width: 400px) {
        .site-wrapper {
            padding-top: 3.5rem;
            padding-bottom: 6rem;
        }
        .artwork-window {
            height: 200px;
            margin-bottom: 3rem;
        }
        .content-flow {
            gap: 2.5rem;
        }
    }
</style>
