---
// Fruiting Currents — Readings Booking Layout
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
        />
        <title>Fruiting Currents</title>
        <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400&family=Instrument+Serif:ital,wght@0,400;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="bg-mist"></div>

        <div class="site-wrapper">
            <header class="main-header">
                <!-- Linked title returning to index -->
                <a href="/" class="header-link">
                    <h1>Fruiting Currents</h1>
                </a>
            </header>

            <main class="content-flow">
                <!-- Page Title -->
                <section class="node">
                    <h2 class="section-title">
                        Vedic Astrology Natal Readings
                    </h2>
                </section>

                <!-- Note from Fiona -->
                <section class="node">
                    <p class="description note-highlight">
                        Note from Fiona: Dear ones, I am navigating moving
                        countries and am currently taking bookings for August
                        and beyond. As my time zone shifts, I may ask to
                        reschedule, please bear with me in finding the right
                        time for us to meet.
                    </p>
                </section>

                <!-- Logistics Details -->
                <section class="node">
                    <p class="description">
                        Readings will last between 60-90 minutes. Donations are
                        appreciated, but not required. You will receive payment
                        instructions after the reading. Please be as detailed as
                        you can in specifying what questions you have coming
                        into the reading.
                    </p>
                </section>

                <section class="node">
                    <p class="description">Questions? Email</p>
                    <p class="description note-highlight">
                        ⇴ fruiting.currents@proton.me ⇴
                    </p>
                </section>

                <div class="divider"></div>

                <!-- Cal App Embed Section -->
                <section class="node embed-node">
                    <!-- Cal inline embed code begins -->
                    <div
                        style="width:100%;height:100%;overflow:scroll"
                        id="my-cal-inline-vedic-astrology-reading"
                    >
                    </div>
                    <script type="text/javascript" is:inline>
                        (function (C, A, L) {
                            let p = function (a, ar) {
                                a.q.push(ar);
                            };
                            let d = C.document;
                            C.Cal =
                                C.Cal ||
                                function () {
                                    let cal = C.Cal;
                                    let ar = arguments;
                                    if (!cal.loaded) {
                                        cal.ns = {};
                                        cal.q = cal.q || [];
                                        d.head.appendChild(
                                            d.createElement("script"),
                                        ).src = A;
                                        cal.loaded = true;
                                    }
                                    if (ar[0] === L) {
                                        const api = function () {
                                            p(api, arguments);
                                        };
                                        const namespace = ar[1];
                                        api.q = api.q || [];
                                        if (typeof namespace === "string") {
                                            cal.ns[namespace] =
                                                cal.ns[namespace] || api;
                                            p(cal.ns[namespace], ar);
                                            p(cal, [
                                                "initNamespace",
                                                namespace,
                                            ]);
                                        } else p(cal, ar);
                                        return;
                                    }
                                    p(cal, ar);
                                };
                        })(
                            window,
                            "https://app.cal.com/embed/embed.js",
                            "init",
                        );
                        Cal("init", "vedic-astrology-reading", {
                            origin: "https://app.cal.com",
                        });
                        Cal.config = Cal.config || {};
                        Cal.config.forwardQueryParams = true;

                        Cal.ns["vedic-astrology-reading"]("inline", {
                            elementOrSelector:
                                "#my-cal-inline-vedic-astrology-reading",
                            config: {
                                layout: "month_view",
                                useSlotsViewOnSmallScreen: "true",
                            },
                            calLink: "fruitingcurrents/vedic-astrology-reading",
                        });

                        Cal.ns["vedic-astrology-reading"]("ui", {
                            hideEventTypeDetails: false,
                            layout: "month_view",
                        });
                    </script>
                    <!-- Cal inline embed code ends -->
                </section>
            </main>
        </div>
    </body>
</html>

<style>
    /* CONSOLIDATED FONT CONFIGURATION */
    :root {
        --font-primary:
            "Geist Mono", monospace; /* Global body, descriptions, about text */
        --font-secondary:
            "Instrument Serif", serif; /* Main navigation links / secondary headers */
        --font-accent: "Instrument Serif", serif; /* Main site header title */
    }

    /* Absolute Core Reset */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html,
    body {
        background-color: #f6f3f0;
        color: #2a2825;
        font-family: var(--font-primary);
        overflow-x: hidden;
        width: 100%;
        -webkit-text-size-adjust: 100%;
    }

    body {
        position: relative;
    }

    /* Soft ambient background mist */
    .bg-mist {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle at 20% 15%,
            rgba(213, 226, 235, 0.4) 0%,
            rgba(243, 215, 215, 0.35) 50%,
            rgba(246, 243, 240, 0) 100%
        );
        z-index: 0;
        pointer-events: none;
    }

    /* Central Containment Frame */
    .site-wrapper {
        position: relative;
        z-index: 1;
        max-width: 460px;
        margin: 0 auto;
        padding: 5rem 1.25rem 8rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Perfectly centered header with mirrored top/bottom margins */
    .main-header {
        width: 100%;
        text-align: center;
        margin-top: 1rem;
        margin-bottom: 3.5rem;
    }

    /* Resets traditional link appearance for the main header */
    .header-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
        outline: none;
    }

    .main-header h1 {
        font-family: var(--font-accent);
        font-weight: 400;
        font-size: clamp(2.25rem, 8vw, 3rem);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #8a8278;
        filter: blur(0.5px);
        line-height: 1.2;
        transition: color 0.2s ease;
    }

    /* Subtle hover indicator keeping the soft atmospheric aesthetic */
    .header-link:hover h1 {
        color: #6a635a;
    }

    /* Main body text architecture */
    .content-flow {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        text-align: center;
    }

    .node {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .section-title {
        font-family: var(--font-secondary);
        font-style: italic;
        font-size: 1.65rem;
        color: #2a2825;
        font-weight: 400;
        letter-spacing: normal;
    }

    .description {
        font-size: 1rem;
        line-height: 1.6;
        color: #6a635a;
        font-weight: 300;
        max-width: 360px;
    }

    /* Subtle typographic shift to soften the note's presence */
    .note-highlight {
        color: #786f64;
        font-style: italic; /* This adds the italic styling */
    }

    .divider {
        width: 35px;
        height: 1px;
        background-color: #e2ded9;
        margin: 0.5rem auto;
    }

    /* Framing constraint to ensure Cal script sets up cleanly */
    .embed-node {
        width: 100%;
        min-height: 600px;
        border-radius: 2px;
        overflow: hidden;
    }

    /* Mobile adjustments */
    @media (max-width: 400px) {
        .site-wrapper {
            padding-top: 3.5rem;
            padding-bottom: 6rem;
        }
        .content-flow {
            gap: 2.5rem;
        }
        .section-title {
            font-size: 1.45rem;
        }
        .embed-node {
            min-height: 520px;
        }
    }
</style>
